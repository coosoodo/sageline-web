# Supabase (필수) — 프로젝트 대시보드 > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 방문자 수 집계용 (서버 전용 — NEXT_PUBLIC_ 을 붙이지 말 것)
# 대시보드 > Settings > API Keys 의 Secret key(sb_secret_...) 또는 Legacy 탭의 service_role 키.
# supabase/site_visits.sql 을 먼저 실행한다.
# 비워 두면 푸터의 방문자 수가 표시되지 않을 뿐 사이트는 정상 동작한다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 사이트 절대 URL (sitemap·OG·OAuth redirect 기준). 미설정 시 https://sageline.co.kr
NEXT_PUBLIC_SITE_URL=https://sageline.co.kr
